# --- Server ---
NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://playr:playr@localhost:5432/playr

# Long random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# IGDB is authenticated through Twitch OAuth (client credentials).
# Register an app at https://dev.twitch.tv/console/apps to get these.
# These are SERVER-SIDE ONLY and must never reach the browser.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Only needed if the client is hosted on a different origin than the API.
# Leave empty for the default single-service deployment.
CORS_ORIGIN=
